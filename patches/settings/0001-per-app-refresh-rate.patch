+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.graphics.drawable.Drawable;
+import android.hardware.display.DisplayManager;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.view.Display;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Lets the user choose a fixed refresh rate per app. The choices are stored in
+ * Settings.System "per_app_refresh_rate" as "package=rate,package=rate" and are applied by
+ * WindowManager's RefreshRatePolicy while the app is visible.
+ */
+public class PerAppRefreshRateFragment extends SettingsPreferenceFragment {
+
+    /** Must match PerAppRefreshRateStore.SETTING in the framework. */
+    static final String SETTING = "per_app_refresh_rate";
+
+    private static final String KEY_INFO = "per_app_refresh_rate_info";
+    private static final int FOLLOW_SYSTEM = -1;
+
+    private final Handler mMainHandler = new Handler(Looper.getMainLooper());
+    private ExecutorService mExecutor;
+    private boolean mLoaded;
+
+    private static class AppItem {
+        String packageName;
+        CharSequence label;
+        Drawable icon;
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.DISPLAY;
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.per_app_refresh_rate_settings;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        mExecutor = Executors.newSingleThreadExecutor();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        if (!mLoaded) {
+            mLoaded = true;
+            loadApps();
+        }
+    }
+
+    @Override
+    public void onDestroy() {
+        super.onDestroy();
+        if (mExecutor != null) {
+            mExecutor.shutdownNow();
+        }
+    }
+
+    private void loadApps() {
+        final Context context = getContext();
+        if (context == null) {
+            return;
+        }
+        final PackageManager pm = context.getPackageManager();
+        mExecutor.execute(() -> {
+            final Intent launcher = new Intent(Intent.ACTION_MAIN)
+                    .addCategory(Intent.CATEGORY_LAUNCHER);
+            final List<ResolveInfo> infos = pm.queryIntentActivities(launcher, 0);
+            final Set<String> seen = new HashSet<>();
+            final List<AppItem> items = new ArrayList<>();
+            for (ResolveInfo info : infos) {
+                final String pkg = info.activityInfo.packageName;
+                if (!seen.add(pkg)) {
+                    continue;
+                }
+                final AppItem item = new AppItem();
+                item.packageName = pkg;
+                item.label = info.loadLabel(pm);
+                item.icon = info.loadIcon(pm);
+                items.add(item);
+            }
+            items.sort((a, b) -> a.label.toString().compareToIgnoreCase(b.label.toString()));
+            mMainHandler.post(() -> showApps(items));
+        });
+    }
+
+    private void showApps(List<AppItem> items) {
+        final Context context = getContext();
+        final PreferenceScreen screen = getPreferenceScreen();
+        if (context == null || screen == null || !isAdded()) {
+            return;
+        }
+        screen.removeAll();
+
+        final Preference info = new Preference(getPrefContext());
+        info.setKey(KEY_INFO);
+        info.setSummary(R.string.per_app_refresh_rate_info);
+        info.setSelectable(false);
+        info.setOrder(-1);
+        screen.addPreference(info);
+
+        final List<Integer> rates = getSupportedRates(context);
+        final List<CharSequence> entries = new ArrayList<>();
+        final List<CharSequence> values = new ArrayList<>();
+        entries.add(getString(R.string.per_app_refresh_rate_default));
+        values.add(String.valueOf(FOLLOW_SYSTEM));
+        for (int rate : rates) {
+            entries.add(getString(R.string.per_app_refresh_rate_hz, rate));
+            values.add(String.valueOf(rate));
+        }
+
+        final Map<String, Integer> saved = readSaved(context);
+        for (AppItem item : items) {
+            final ListPreference pref = new ListPreference(getPrefContext());
+            pref.setKey(item.packageName);
+            pref.setTitle(item.label);
+            pref.setIcon(item.icon);
+            pref.setEntries(entries.toArray(new CharSequence[0]));
+            pref.setEntryValues(values.toArray(new CharSequence[0]));
+            pref.setDialogTitle(item.label);
+            pref.setPersistent(false);
+            final Integer current = saved.get(item.packageName);
+            pref.setValue(String.valueOf(current != null && rates.contains(current)
+                    ? current : FOLLOW_SYSTEM));
+            pref.setSummaryProvider(ListPreference.SimpleSummaryProvider.getInstance());
+            pref.setOnPreferenceChangeListener((p, newValue) -> {
+                saveRate(context, item.packageName, Integer.parseInt((String) newValue));
+                return true;
+            });
+            screen.addPreference(pref);
+        }
+    }
+
+    /** Distinct whole-number refresh rates of the built-in display's modes. */
+    private static List<Integer> getSupportedRates(Context context) {
+        final TreeSet<Integer> rates = new TreeSet<>();
+        final DisplayManager dm = context.getSystemService(DisplayManager.class);
+        final Display display = dm.getDisplay(Display.DEFAULT_DISPLAY);
+        if (display != null) {
+            for (Display.Mode mode : display.getSupportedModes()) {
+                rates.add(Math.round(mode.getRefreshRate()));
+            }
+        }
+        return new ArrayList<>(rates);
+    }
+
+    private static Map<String, Integer> readSaved(Context context) {
+        final Map<String, Integer> map = new HashMap<>();
+        final String raw = Settings.System.getString(context.getContentResolver(), SETTING);
+        if (raw == null || raw.isEmpty()) {
+            return map;
+        }
+        for (String entry : raw.split(",")) {
+            final int eq = entry.indexOf('=');
+            if (eq <= 0) {
+                continue;
+            }
+            try {
+                map.put(entry.substring(0, eq), Integer.parseInt(entry.substring(eq + 1)));
+            } catch (NumberFormatException ignored) {
+                // skip malformed entry
+            }
+        }
+        return map;
+    }
+
+    private static void saveRate(Context context, String packageName, int rate) {
+        final Map<String, Integer> map = readSaved(context);
+        if (rate > 0) {
+            map.put(packageName, rate);
+        } else {
+            map.remove(packageName);
+        }
+        final StringBuilder sb = new StringBuilder();
+        for (Map.Entry<String, Integer> e : map.entrySet()) {
+            if (sb.length() > 0) {
+                sb.append(',');
+            }
+            sb.append(e.getKey()).append('=').append(e.getValue());
+        }
+        Settings.System.putString(context.getContentResolver(), SETTING, sb.toString());
+    }
+}
